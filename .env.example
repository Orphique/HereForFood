# ============================================================================
# HereForFood — environment configuration
# Copy this file to ".env" and fill in your values.
# ============================================================================

# Server
PORT=3000

# --- AI provider selection -------------------------------------------------
# "foundry" = use Microsoft Azure AI Foundry Agent Service (real AI).
# "mock"    = use the built-in offline agent (no Azure needed, great for dev/demos).
AI_PROVIDER=mock

# --- Azure AI Foundry Agent Service ----------------------------------------
# Get these from the Azure AI Foundry portal (https://ai.azure.com):
#   Project endpoint: Project overview -> "Azure AI Foundry project endpoint"
#   Model deployment: the *deployment name* you created (e.g. gpt-4o, gpt-4o-mini)
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://decade-ai-foundry-works-resource.services.ai.azure.com/api/projects/decade-ai-foundry-workshop
AZURE_AI_FOUNDRY_MODEL_DEPLOYMENT=gpt-5-mini

# --- Use the agent you created in the Foundry portal -----------------------
# Foundry portal -> your project -> Agents -> click your agent -> copy its ID
# (it looks like "asst_AbC123..."). With this set, HereForFood reuses YOUR agent
# instead of creating a temporary one per request.
# Leave blank to fall back to an ephemeral agent created/deleted per request.
AZURE_AI_FOUNDRY_AGENT_ID=

# On first request the app pushes HereForFood's function tools onto that agent
# (identify_food, lookup_nutrition, estimate_meal, log_meal, get_dashboard,
# recommend_meals, plan_meals, get_recipe, find_local_food) so it can actually
# call them. Set to false to leave your portal agent's config untouched.
AZURE_AI_FOUNDRY_SYNC_AGENT=false

# Authentication is handled by DefaultAzureCredential.
# Easiest for local dev: run `az login` in your terminal before starting the app.
# In production, use a Managed Identity instead — no secrets in code.

# --- Database provider selection -------------------------------------------
# "json"     = local JSON file (default, zero setup).
# "supabase" = PostgreSQL via Supabase (run db/schema.sql + db/seed.js first).
DB_PROVIDER=json

# --- Supabase (only needed when DB_PROVIDER=supabase) ----------------------
# From the Supabase dashboard -> Project Settings -> API:
#   SUPABASE_URL              : Project URL
#   SUPABASE_SERVICE_ROLE_KEY : service_role key (SERVER ONLY — never ship to the app)
#   SUPABASE_ANON_KEY         : anon/public key (safe for client-side auth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# New-style Foundry agent (versioned, with a Publish button in the portal).
# Set this to use it via the Responses API. Takes precedence over the classic
# AZURE_AI_FOUNDRY_AGENT_ID (asst_...) agent.
AZURE_AI_FOUNDRY_AGENT_NAME=decade-ai
